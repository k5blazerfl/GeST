#!/bin/sh
# helm-session — the HeDE session supervisor.
#
# Sets the session environment and execs a Wayland compositor with HeDE's
# shipped config; the compositor's autostart brings up the HeDE shell. When the
# compositor exits, the session ends. Pick the compositor with HELM_COMPOSITOR
# (default labwc; "wayfire" for the opt-in effects profile). See
# docs/design/hede-phase0.md §3.2 and desktop-environment.md §4.

export XDG_CURRENT_DESKTOP=HeDE
export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORM=wayland
# Window decorations. Default: server-side (labwc draws the titlebar) — Qt's
# client-side titlebar is disabled so shell-launched apps aren't frameless.
# Opt-in HELM_CSD=1 switches Qt apps to the `helm` client-side decoration plugin
# (painterly nine-patch frames from the active world), the path to true painterly
# titlebars labwc's SSD can't provide. Still being QEMU-verified (visual +
# SSD/CSD negotiation with labwc); see docs/design/hede-theme.md.
if [ "${HELM_CSD:-0}" = "1" ]; then
	export QT_WAYLAND_DECORATION=helm
	unset QT_WAYLAND_DISABLE_WINDOWDECORATION
else
	export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
fi

: "${HELM_COMPOSITOR:=labwc}"

case "$HELM_COMPOSITOR" in
wayfire)
	exec wayfire -c "${HELM_WAYFIRE_CONFIG:-/usr/share/hede/wayfire/wayfire.ini}"
	;;
*)
	exec labwc -C "${HELM_LABWC_CONFIG:-/usr/share/hede/labwc}"
	;;
esac

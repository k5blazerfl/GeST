<?xml version="1.0"?>
<!-- HeDE labwc defaults (Phase 0). GeST will generate this file later; for now
     it ships two keybinds so the desktop is usable before there's a launcher. -->
<labwc_config>
  <keyboard>
    <!-- Super+Return → terminal -->
    <keybind key="W-Return">
      <action name="Execute"><command>foot</command></action>
    </keybind>
    <!-- Super+Q → close the focused window -->
    <keybind key="W-q">
      <action name="Close"/>
    </keybind>
    <!-- Super+L → lock the screen (adopted swaylock) -->
    <keybind key="W-l">
      <action name="Execute"><command>swaylock -f</command></action>
    </keybind>
    <!-- Aero-Snap: Super+arrows (edge-drag snapping is labwc-native) -->
    <keybind key="W-Left">
      <action name="SnapToEdge" direction="left"/>
    </keybind>
    <keybind key="W-Right">
      <action name="SnapToEdge" direction="right"/>
    </keybind>
    <keybind key="W-Up">
      <action name="ToggleMaximize"/>
    </keybind>
    <keybind key="W-Down">
      <action name="Iconify"/>
    </keybind>
  </keyboard>
</labwc_config>

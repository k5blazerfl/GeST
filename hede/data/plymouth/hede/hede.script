// HeDE boot splash — the Harbor scene under a thin accent progress tracker at the
// bottom. Colours track hede-tokens (accent #3aa6c4). One 256-colour image keeps
// it reasonably light in the initramfs.

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

// Fallback fill if the image can't load: Harbor deep navy (#0a1633).
Window.SetBackgroundTopColor(0.039, 0.086, 0.200);
Window.SetBackgroundBottomColor(0.039, 0.086, 0.200);

// Full-screen Harbor scene, scaled to fill the display.
bg.sprite = Sprite(Image("background.png").Scale(screen_w, screen_h));
bg.sprite.SetPosition(0, 0, 0);

// Progress tracker — bottom middle: a teal fill growing over a faint rail.
track.w = screen_w * 0.30;
track.x = screen_w / 2 - track.w / 2;
track.y = screen_h - 54;

rail.sprite = Sprite(Image.Text(" ", 0.85, 0.9, 0.95).Scale(track.w, 3));
rail.sprite.SetPosition(track.x, track.y, 1);
rail.sprite.SetOpacity(0.18);

bar.pixel = Image.Text(" ", 0.227, 0.651, 0.769);   // #3aa6c4 teal
bar.sprite = Sprite(bar.pixel.Scale(2, 3));
bar.sprite.SetPosition(track.x, track.y, 2);

fun boot_progress_cb(duration, pct) {
    width = track.w * pct;
    if (width < 2) width = 2;
    bar.sprite.SetImage(bar.pixel.Scale(width, 3));
    bar.sprite.SetPosition(track.x, track.y, 2);
}
Plymouth.SetBootProgressFunction(boot_progress_cb);

// Boot messages are suppressed by the quiet cmdline; keep any off the clean splash.
fun message_cb(text) { }
Plymouth.SetMessageFunction(message_cb);

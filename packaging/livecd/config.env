# Configuration for the GeST installer live-image build (sourced by build.sh).
# Fill these in for your build host, then run:  packaging/livecd/build.sh amd64
#
# Everything the specs need that is host- or time-specific lives here, so the
# spec templates (amd64/*.spec.in) stay static.

# The profile the image is built against. MUST match the target arch — the amd64
# default below is for `build.sh amd64`; for `build.sh arm64` set this to an
# Asahi-appropriate arm64 profile (from the Asahi overlay) so the Apple-Silicon
# USE/KEYWORDS apply.
PROFILE="default/linux/amd64/23.0/desktop"

# The ebuild-repo snapshot treeish (catalyst 4.x). Make it first with
# `catalyst -s stable` (clones gentoo.git's stable branch), then set this to the
# treeish you passed — normally `stable`.
SNAPSHOT="stable"

# The stage3 seed subpath under catalyst's builds/ (no .tar.xz), used as the
# livecd-stage1 source. Example: stage3-amd64-openrc-20260810T170331Z
STAGE3="CHANGE-ME-stage3-seed"

# Where the GeST overlay lives on the build host. Clone this repo's
# packaging/overlay/ there (or point at an already-registered repo), so
# app-admin/gest resolves during the build.
GEST_OVERLAY="/var/db/repos/gest"

# amd64 ONLY: the Amphitheater overlay, where gui-apps/hede (the desktop that
# fronts the installer) lives. Clone github.com/k5blazerfl/Amphitheater and point
# here so gui-apps/hede resolves during the build. Ignored by the arm64 build.
HEDE_OVERLAY="/var/db/repos/amphitheater"

# arm64 (Apple Silicon / Asahi) ONLY: where the Asahi overlay lives on the build
# host, for asahi-meta / the Asahi kernel / m1n1 / U-Boot. Register chadmed's
# asahi-overlay (e.g. `eselect repository enable asahi` → /var/db/repos/asahi).
# Ignored by the amd64 build.
ASAHI_OVERLAY="/var/db/repos/asahi"

# Build timestamp — leave empty to auto-stamp with the current date at build time
# (build.sh fills it). Must match between stage1 and stage2, which build.sh
# guarantees by computing it once.
TIMESTAMP=""

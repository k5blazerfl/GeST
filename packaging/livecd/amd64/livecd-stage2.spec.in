# catalyst livecd-stage2 for the GeST amd64 installer image (TEMPLATE).
#
# build.sh renders this to build/livecd-stage2.spec (substituting ${VARS} from
# config.env). Stage 2 takes livecd-stage1's build root, adds a kernel +
# bootloader, lays down the root overlay + runs the fsscript (enable the seat/
# login + greeter services), and packs a hybrid ISO (BIOS + UEFI) that boots
# straight into the HeDE desktop, from which GeST installs Gentoo.

subarch: amd64
version_stamp: gest-${TIMESTAMP}
target: livecd-stage2
rel_type: default
profile: ${PROFILE}
snapshot_treeish: ${SNAPSHOT}
portage_confdir: ${PORTAGE_CONFDIR}
source_subpath: default/livecd-stage1-amd64-gest-${TIMESTAMP}

# Same overlays as stage1 (catalyst 4.x `repos` key), so anything the kernel/
# fsscript step touches still resolves.
repos: ${GEST_OVERLAY} ${HEDE_OVERLAY}

# kernel — full sources: catalyst's livecd flow runs genkernel to build the
# kernel AND the livecd initramfs (which knows how to find + mount the ISO's
# squashfs). A dist-kernel (gentoo-kernel-bin) ships a stripped source tree that
# genkernel can't compile ("prepare" target fails), so it can't be used here.
boot/kernel: gentoo
boot/kernel/gentoo/sources: sys-kernel/gentoo-sources

# image: a squashfs root packed into a hybrid, UEFI-capable ISO
livecd/type: generic-livecd
livecd/fstype: squashfs
livecd/iso: gest-installer-amd64-${TIMESTAMP}.iso
livecd/volid: GEST_INSTALLER
livecd/motd: ${MOTD}

# Files copied into the image root before fsscript runs: /etc/greetd/config.toml,
# which autologins the boot straight into the HeDE session.
livecd/root_overlay: ${ROOT_OVERLAY}

# Run inside the stage2 chroot after packages install: enable the seat/login +
# greeter services so the image boots into HeDE (the Helm Desktop Environment),
# from which the user runs GeST to install Gentoo.
livecd/fsscript: ${FSSCRIPT}

# Packages for the GeST amd64 installer live image (catalyst livecd/packages).
# GeST itself (its ebuild RDEPENDs pull portage, pygobject:3, urwid, dbus-next,
# polkit and dbus) plus every tool GeST's install path shells out to, so the
# installer works offline-of-Portage on the live medium.
#
# Keep this in sync with the `livecd/packages:` block in livecd-stage1.spec.

# GeST (from the GeST overlay — see portage_overlay in the stage1 spec)
app-admin/gest

# storage provisioning: partition, mkfs, swap, mount
sys-apps/gptfdisk          # sgdisk
sys-block/parted
sys-apps/util-linux      # mount, lsblk, wipefs, swapon
sys-fs/e2fsprogs         # ext4
sys-fs/xfsprogs          # xfs
sys-fs/btrfs-progs       # btrfs
sys-fs/f2fs-tools        # f2fs
sys-fs/dosfstools        # vfat (the ESP)
sys-fs/ntfs3g            # ntfs (mkfs.ntfs — Windows/interop data partitions)

# make.conf tuning: WriteMakeConf shells out to cpuid2cpuflags to detect the
# target's CPU_FLAGS_X86. Without it on the live image the detection silently
# no-ops and CPU_FLAGS_X86 is left at the stage3 default. (x86-only; arm64 would
# use CPU_FLAGS_ARM.)
app-portage/cpuid2cpuflags
sys-fs/exfatprogs        # exfat (mkfs.exfat — removable/interop data partitions)

# stage3 fetch + verify + unpack
net-misc/wget
app-arch/tar
app-arch/xz-utils
app-crypt/gnupg

# kernel + bootloader
sys-kernel/genkernel
sys-boot/grub
sys-boot/efibootmgr

# network (live env + the target's config tools)
net-misc/dhcpcd
net-wireless/wpa_supplicant
net-wireless/iw

# day-2 firewall backends GeST's Firewall module can drive
net-firewall/nftables
net-firewall/firewalld

# the D-Bus / polkit runtime the backend needs (also pulled by gest, listed for clarity)
sys-auth/polkit
sys-apps/dbus

# desktop: HeDE (the Helm Desktop Environment) is the face of the installer.
# gui-apps/hede's RDEPENDs pull labwc, foot, gest, lxqt-policykit, wireplumber,
# and swaylock/swayidle; add seat/login + the autologin DM here.
gui-apps/hede
# Seats/login come from systemd-logind (built into the systemd profile); no
# elogind. seatd stays only as a libseat fallback — logind is the active backend.
sys-auth/seatd           # libseat fallback (logind is the primary seat backend)
gui-libs/greetd          # autologin into the HeDE session (systemd unit; see fsscript.sh)
sys-boot/plymouth        # seamless graphical boot; the HeDE splash theme ships with gui-apps/hede

# Full-BMP glyph coverage so the shell's symbols render (e.g. the ⎈ Start mark,
# U+2388) instead of tofu. unifont is tiny (~12 MB) and guaranteed to cover the
# BMP; the polished Noto Sans Symbols is 445 MB of Noto monolith — too heavy for
# the ISO's 2 GB budget. The bar keeps a text label so meaning survives regardless.
media-fonts/unifont      # symbols/fallback coverage for shell glyphs

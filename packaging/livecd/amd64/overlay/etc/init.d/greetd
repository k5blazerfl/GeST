#!/sbin/openrc-run
# OpenRC service for greetd. gui-libs/greetd ships only a systemd unit, so the
# GeSI live image (OpenRC) provides its own. greetd reads /etc/greetd/config.toml
# and, on this image, autologins into the HeDE session on vt1.
supervisor=supervise-daemon
command="/usr/bin/greetd"
command_args="--config /etc/greetd/config.toml"
description="greetd login/greeter daemon"

depend() {
	need dbus
	after elogind
	provide display-manager
}

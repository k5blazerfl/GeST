# catalyst livecd-stage1 for the BAREBONES GeSI CLI installer image (TEMPLATE).
#
# The `cli` build flavor: packaging/livecd/build.sh amd64 cli renders this to
# build/livecd-stage1.spec by substituting the ${VARS} from config.env and
# appending the package list from amd64/gest-cli.packages — do not edit the
# rendered copy; edit this template or config.env.
#
# Stage 1 of two: builds app-admin/gest and the install-path tools into a build
# root seeded from a stage3. Stage 2 adds the kernel + bootloader and packs a
# small console-only ISO that boots straight into GeST's guided TUI installer.
#
# Unlike the desktop image's stage1, this pulls ONLY the GeST overlay — there is
# no gui-apps/hede here, so the Amphitheater overlay is not needed.

subarch: amd64
version_stamp: gesi-cli-${TIMESTAMP}
target: livecd-stage1
rel_type: default
profile: ${PROFILE}
snapshot_treeish: ${SNAPSHOT}
source_subpath: default/${STAGE3}

# Make app-admin/gest (GeST overlay) resolvable during the build. catalyst 4.x
# spec key is `repos` (space-separated). No HeDE overlay — this image has no desktop.
repos: ${GEST_OVERLAY}

# ~amd64 keyword for the GeST ebuild (packaging/livecd/portage-conf/).
portage_confdir: ${PORTAGE_CONFDIR}

# The image's package set is appended here by build.sh from amd64/gest-cli.packages.
livecd/packages:

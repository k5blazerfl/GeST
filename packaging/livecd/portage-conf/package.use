# USE flags for the GeST installer live image (applied via portage_confdir in
# the stage1 spec).

# The live image boots into HeDE, whose Control Center *is* GeST's Qt frontend
# (gest-settings). Build gest with USE=qt so PySide6 and gest-settings are
# present — without this the desktop comes up but its Settings do nothing.
app-admin/gest qt

# HeDE is a Qt/Wayland shell: qtbase needs the wayland client (+ opengl/gui,
# required by wayland; widgets/dbus for the Control Center). The rest of the Qt/
# wlroots stack resolves from the desktop profile defaults.
dev-qt/qtbase:6 dbus gui opengl wayland widgets

# Trim PySide6 to the modules gest-settings actually imports: QtWidgets, QtCore,
# QtGui (i.e. core/gui/widgets). GeST's Qt Control Center loads no other Qt
# module — its D-Bus IPC is Python (dbus-next), not QtDBus — so drop the
# default-on bindings it never touches. Saves ~4 MB of unused .so bindings off
# the image. NOTE: opengl is deliberately kept — dev-python/pyside pins its
# opengl USE to dev-qt/qtbase[opengl=], which the Wayland desktop requires, so
# the (large) QtOpenGL binding can't be dropped here without breaking the shell.
dev-python/pyside:6 -concurrent -dbus -network -printsupport -sql -testlib -xml

# firewalld drives nftables with the json/python/xtables backends.
net-firewall/nftables json python xtables

# Break the docutils<->pillow<->harfbuzz<->glib build cycle (Sphinx doc toolchain
# pulled transitively); portage's suggested cycle-breaker.
dev-python/pillow -truetype

# gentoo-kernel-bin[initramfs] (dist-kernel) needs installkernel's dracut backend.
sys-kernel/installkernel dracut

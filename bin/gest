#!/usr/bin/env bash
# Launch the GeST TUI from the working tree using its own venv.
# The venv must be created with --system-site-packages so that the system
# Portage Python API is importable (see README).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Force the working tree onto sys.path ahead of any system-installed GeST
# (the --system-site-packages venv can otherwise shadow it with the emerged
# copy when launched from outside the repo).
exec env PYTHONPATH="${here}${PYTHONPATH:+:${PYTHONPATH}}" \
    "${here}/.venv/bin/python" -m gest "$@"

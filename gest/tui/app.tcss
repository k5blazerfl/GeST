/* GeST TUI styling — a restrained, YaST-ish blue accent. */

Screen {
    background: $surface;
}

/* --- Control Center (two-pane main menu) --- */
#cc-header {
    text-align: center;
    text-style: bold;
    color: $primary;
    border: round $primary;
    margin: 1 2 0 2;
    padding: 0 1;
}

#cc-body {
    height: 1fr;
    margin: 1 2;
}

#cc-categories {
    width: 32;
    border: round $primary;
    margin-right: 1;
}

#cc-modules {
    width: 1fr;
    border: round $primary;
}

#cc-buttons {
    height: auto;
    margin: 0 2 1 2;
}

#cc-spacer {
    width: 1fr;
}

#search {
    margin: 1 2 0 2;
}

#status {
    margin: 0 2;
    color: $text-muted;
}

#results {
    height: 1fr;
    margin: 1 2;
}

#install-title {
    text-style: bold;
    color: $primary;
    margin: 1 2 0 2;
}

#install-status {
    margin: 0 2;
    color: $text-muted;
}

#log {
    height: 1fr;
    margin: 1 2;
    border: round $panel-lighten-2;
}

#install-buttons {
    height: auto;
    margin: 0 2 1 2;
}

#install-buttons Button {
    margin-right: 2;
}

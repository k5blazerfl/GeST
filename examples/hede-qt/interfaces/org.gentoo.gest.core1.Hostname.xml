<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- gestd Hostname interface. Captured from `gdbus introspect`; the QtTypeName
     annotations tell qdbusxml2cpp which C++ type to map each container to
     (a{sv} -> QVariantMap, which QtDBus marshals natively). -->
<node>
  <interface name="org.gentoo.gest.core1.Hostname">
    <method name="GetState">
      <arg direction="out" type="a{sv}"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantMap"/>
    </method>
    <method name="Validate">
      <arg name="name" direction="in" type="s"/>
      <arg direction="out" type="b"/>
      <arg direction="out" type="s"/>
    </method>
    <method name="Render">
      <arg name="name" direction="in" type="s"/>
      <arg direction="out" type="s"/>
    </method>
  </interface>
</node>

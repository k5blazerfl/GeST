<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- gestd Software interface (a template for HeDE's package panel). The list
     methods return aa{sv} -> QList<QVariantMap>; a consumer must register that
     container once with qDBusRegisterMetaType<QList<QVariantMap>>() (QVariantMap
     itself is built in). Counts is a{sx} -> QMap<QString,qlonglong>. -->
<node>
  <interface name="org.gentoo.gest.core1.Software">
    <method name="ListInstalled">
      <arg direction="out" type="aa{sv}"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QList&lt;QVariantMap&gt;"/>
    </method>
    <!-- Paged installed list: CountInstalled for the total, ListInstalledPage for a
         window (limit 0 = the rest), RefreshInstalled to re-read Portage. Reads snapshot
         once server-side, so a QAbstractItemModel can fetchMore() without re-reading. -->
    <method name="CountInstalled">
      <arg direction="out" type="u"/>
    </method>
    <method name="ListInstalledPage">
      <arg name="offset" direction="in" type="u"/>
      <arg name="limit" direction="in" type="u"/>
      <arg direction="out" type="aa{sv}"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QList&lt;QVariantMap&gt;"/>
    </method>
    <method name="RefreshInstalled">
      <arg direction="out" type="u"/>
    </method>
    <method name="ListUpgradable">
      <arg direction="out" type="aa{sv}"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QList&lt;QVariantMap&gt;"/>
    </method>
    <method name="Search">
      <arg name="term" direction="in" type="s"/>
      <arg name="fields" direction="in" type="as"/>
      <arg name="mode" direction="in" type="s"/>
      <arg name="ignore_case" direction="in" type="b"/>
      <arg name="limit" direction="in" type="i"/>
      <arg direction="out" type="aa{sv}"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QList&lt;QVariantMap&gt;"/>
    </method>
    <method name="PackagesInCategory">
      <arg name="category" direction="in" type="s"/>
      <arg name="limit" direction="in" type="i"/>
      <arg direction="out" type="aa{sv}"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QList&lt;QVariantMap&gt;"/>
    </method>
    <method name="ListCategories">
      <arg direction="out" type="as"/>
    </method>
    <method name="GetDetail">
      <arg name="cp" direction="in" type="s"/>
      <arg direction="out" type="a{sv}"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantMap"/>
    </method>
    <method name="Counts">
      <arg direction="out" type="a{sx}"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QMap&lt;QString,qlonglong&gt;"/>
    </method>
  </interface>
</node>

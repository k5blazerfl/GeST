<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- The System interface on the polkit-gated ROOT backend (system bus, name
     org.gentoo.gest). This is the WRITE side — where the C++ view applies a
     change gestd only read/validated/rendered. Each Set* is polkit-gated
     (org.gentoo.gest.system.configure); ``root`` is "/" for the running system.
     All args are basic types, so no QtTypeName annotations are needed. -->
<node>
  <interface name="org.gentoo.gest.System">
    <method name="SetHostname">
      <arg name="name" direction="in" type="s"/>
      <arg name="root" direction="in" type="s"/>
      <arg name="ok" direction="out" type="b"/>
      <arg name="output" direction="out" type="s"/>
    </method>
    <method name="SetTimezone">
      <arg name="zone" direction="in" type="s"/>
      <arg name="root" direction="in" type="s"/>
      <arg name="ok" direction="out" type="b"/>
      <arg name="output" direction="out" type="s"/>
    </method>
    <method name="SetLocale">
      <arg name="lang" direction="in" type="s"/>
      <arg name="root" direction="in" type="s"/>
      <arg name="ok" direction="out" type="b"/>
      <arg name="output" direction="out" type="s"/>
    </method>
    <method name="SetKeymap">
      <arg name="keymap" direction="in" type="s"/>
      <arg name="root" direction="in" type="s"/>
      <arg name="ok" direction="out" type="b"/>
      <arg name="output" direction="out" type="s"/>
    </method>
    <method name="SetConsoleFont">
      <arg name="font" direction="in" type="s"/>
      <arg name="root" direction="in" type="s"/>
      <arg name="ok" direction="out" type="b"/>
      <arg name="output" direction="out" type="s"/>
    </method>
  </interface>
</node>
